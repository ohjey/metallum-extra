{
  "schemaVersion": 1,
  "id": "metallum-extra",
  "version": "${version}",
  "name": "Metallum Extra",
  "description": "Add-on for Metallum: built-in shaders (sun shadows, lit water, glow), stutter fixes and a frame-hitch profiler for the Metal backend on Apple Silicon.",
  "authors": ["ohjey"],
  "contact": {
    "homepage": "https://github.com/ohjey/metallum-extra",
    "sources": "https://github.com/ohjey/metallum-extra",
    "issues": "https://github.com/ohjey/metallum-extra/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.metallumextra.MetallumExtra"],
    "modmenu": ["com.metallumextra.ModMenuIntegration"],
    "sodium:config_api_user": ["com.metallumextra.SodiumOptionsIntegration"]
  },
  "mixins": ["metallum-extra.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.2-",
    "java": ">=25",
    "metallum": ">=${metallum_version} <=${metallum_max_version}"
  },
  "custom": {
    "metallum-extra:note": "Hooks Metallum internals; only accepts the Metallum versions it was checked against."
  }
}
